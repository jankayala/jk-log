{
  "name": "jk-log",
  "version": "2.1.4",
  "description": "A tiny Node.js utility that enhances console.log with ANSI colors and formatting, making terminal output cleaner, more readable, and visually expressive with minimal setup.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jankayala/jk-log.git"
  },
  "bugs": {
    "url": "https://github.com/jankayala/jk-log/issues"
  },
  "homepage": "https://github.com/jankayala/jk-log#readme",
  "keywords": [
    "jk-log",
    "logging",
    "console",
    "ansi",
    "colors",
    "formatting",
    "terminal",
    "nodejs"
  ],
  "author": "jankayala",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "bench": "npm run build && node bench/index.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
