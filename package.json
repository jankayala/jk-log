{
  "name": "ansilogger",
  "version": "1.0.0",
  "description": "A tiny Node.js utility that enhances console.log with ANSI colors and formatting, making terminal output cleaner, more readable, and visually expressive with minimal setup.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jankayala/ansilogger.git"
  },
  "bugs": {
    "url": "https://github.com/jankayala/ansilogger/issues"
  },
  "homepage": "https://github.com/jankayala/ansilogger#readme",
  "keywords": [
    "ansilogger",
    "logging",
    "console",
    "ansi",
    "colors",
    "formatting",
    "terminal",
    "nodejs"
  ],
  "author": "jankayala",
  "license": "MIT",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsdown",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "prettier": "3.8.3",
    "tsdown": "0.21.10",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
